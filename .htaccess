Options -Indexes

RewriteEngine On

# Redirect index.html to root
RewriteRule ^index\.html$ / [R=301,L]

# Redirect .html URLs to clean URLs (must come before the rewrite rule)
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# Handle /blog and /blog/ explicitly (blog/ directory exists, so -d check would block it)
RewriteRule ^blog/?$ blog.html [L]

# Serve .html file for clean URLs (root-level pages)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]

# Serve blog posts: /blog/slug → /blog/slug.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/blog/%1.html -f
RewriteRule ^blog/([^/]+)$ blog/$1.html [L]
